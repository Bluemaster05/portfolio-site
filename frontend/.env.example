# Base URL the Next.js server uses to reach the API (server side only)
API_URL=http://localhost:4000

# Read-only API token for the public pages (server side only — never prefix with NEXT_PUBLIC_).
# In development this matches SEED_API_TOKEN in server/.env.
PORTFOLIO_API_TOKEN=dev-portfolio-token

# Base URL the browser uses to reach the API from the admin portal.
# Must share a site with this app so SameSite cookies are sent (e.g. localhost:3000 + localhost:4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: comma-separated IPs / IPv4 CIDRs allowed to open /admin. Unset = everyone (development).
# ADMIN_ALLOWED_IPS=127.0.0.1,::1,192.168.1.0/24

# Optional: a header the proxy in front always overwrites with the real client IP, used by the
# /admin check instead of X-Forwarded-For (which a client can fake). Behind Cloudflare: cf-connecting-ip
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
