NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose maps the container to localhost:5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
# Used by docker compose to initialise the container
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me
CSRF_SECRET=change-me-too

# Comma-separated origins allowed to call the API from a browser (the admin portal)
CORS_ORIGIN=http://localhost:3000

# First admin account, created by `yarn db:seed` when no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional: seed a read-only API token with exactly this value (development convenience).
# Put the same value in frontend/.env.local as PORTFOLIO_API_TOKEN.
SEED_API_TOKEN=dev-portfolio-token
